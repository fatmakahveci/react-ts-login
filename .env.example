# Copy to .env.local for local development; never commit your real values.
DATABASE_URL=postgresql://forma:forma-local@127.0.0.1:5432/forma
BETTER_AUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Disable STARTTLS only for a local test mailbox.
SMTP_REQUIRE_TLS=false
MAIL_FROM=Forma <hello@example.test>
# Only for local production-build testing. Never enable on a public host.
ALLOW_LOCAL_HTTP=false
# Production SMTP only:
# SMTP_USER=
# SMTP_PASSWORD=
