{
  "name": "react-ts-login",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "test:e2e": "playwright test",
    "mail:test": "tsx scripts/test-mail-server.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "postcss": "8.5.30",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.12.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "smtp-server": "3.19.22",
    "typescript": "5.1.6",
    "vitest": "5.0.4"
  },
  "overrides": {
    "postcss": "8.5.30",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
